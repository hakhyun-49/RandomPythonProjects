import random
import tkinter as tk
import string
# importing libraries.
window =tk.Tk()
window.title("Password makerr")
window.geometry("250x200")
#window proportions.
# Widgets
label = tk.Label(window, text="Password length:")
label.pack(pady=10)
length_entry = tk.Entry(window)
length_entry.pack()

char= string.ascii_letters+string.digits+string.punctuation
# we now have characters, digits and symbols we may need to use as in a password.
def pass_gen(length):
  # creating a re-usable function so we can use this again
  password=""
  for v in range(length):
    password=password+random.SystemRandom().choice(char)
  return password
print("Password Generation Program! Welcome. \n ")
while True:
  user_input=input("Please input the length of the password: ")
  try:
    # Using try and except to ensure no invalid data type like str is entered and using an if loop to make sure no negative value is entered.
    user_input=int(user_input)
  except ValueError:
    print("That's not a whole number, please try again: ")
    continue
  if user_input<=0:
    print("Must be positive in length, try again: ")
    continue
  break
print(f"\nYour password is:{pass_gen(user_input)}")
window.mainloop()
    
